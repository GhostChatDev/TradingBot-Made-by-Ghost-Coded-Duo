# Copy to .env and fill in. NEVER commit .env.
# Every value below is a fake placeholder. No real key, seed phrase or secret belongs in this file.

# --- Safety switches (the app starts with both OFF) -------------------------
# paper | devnet   (mainnet is refused while MAINNET_ENABLED=false)
TRADING_MODE=paper
# Leave "false". Only you can turn real-funds trading on, after reading RISKS.md.
MAINNET_ENABLED=false
# test | off   (test = fake money top-ups for credits; no real payment while off)
PAYMENTS_MODE=test

# --- Server ----------------------------------------------------------------
PORT=3000
# Path of the SQLite file. Tests use DATABASE_PATH=:memory:
DATABASE_PATH=./data/bot.sqlite

# --- Devnet RPC (the free public endpoint works) ---------------------------
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Server-only secret used to hash API keys. Placeholder, change it. -----
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_PEPPER=change-me-not-a-real-secret

# --- NOT READ BY THIS BUILD (mainnet stays off) ---------------------------
# These placeholders only show where a value would live if mainnet were ever
# switched on. No code path reads them while TRADING_MODE is not "live".
MAINNET_RPC_URL=https://api.mainnet-beta.solana.com
MAINNET_SIGNER_SECRET_KEY=never-a-real-key-placeholder
